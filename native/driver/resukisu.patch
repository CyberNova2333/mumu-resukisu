diff --git a/kernel/hook/x86_64/ia32_abi.h b/kernel/hook/x86_64/ia32_abi.h
new file mode 100644
--- /dev/null
+++ b/kernel/hook/x86_64/ia32_abi.h
@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef KSU_X86_IA32_ABI_H
+#define KSU_X86_IA32_ABI_H
+
+#include <linux/compat.h>
+#include <linux/ptrace.h>
+#include <asm/unistd.h>
+
+/* This adapter is scoped to the audited x86-64 / IA32 target. */
+#if defined(CONFIG_X86_X32_ABI) || defined(CONFIG_X86_X32)
+#error "IA32 adapter requires a separate audit before enabling the x32 ABI"
+#endif
+
+#ifdef CONFIG_IA32_EMULATION
+#if IA32_NR_syscalls != 451
+#error "IA32 syscall count differs from the audited target table"
+#endif
+static inline unsigned long ksu_ia32_syscall_arg(const struct pt_regs *regs, unsigned int index)
+{
+    switch (index) {
+    case 0: return (u32)regs->bx;
+    case 1: return (u32)regs->cx;
+    case 2: return (u32)regs->dx;
+    case 3: return (u32)regs->si;
+    case 4: return (u32)regs->di;
+    case 5: return (u32)regs->bp;
+    default: return 0;
+    }
+}
+
+static inline bool ksu_ia32_prepare_dispatch(struct pt_regs *regs, long nr, int dispatcher)
+{
+    if (nr < 0 || nr >= IA32_NR_syscalls || dispatcher < 0 || dispatcher >= IA32_NR_syscalls)
+        return false;
+    regs->ax = (u32)nr;
+    regs->orig_ax = dispatcher;
+    return true;
+}
+#endif
+#endif
