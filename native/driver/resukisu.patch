diff --git a/kernel/feature/sucompat.c b/kernel/feature/sucompat.c
index dc8cab81..082f23ba 100644
--- a/kernel/feature/sucompat.c
+++ b/kernel/feature/sucompat.c
@@ -317,6 +317,174 @@ long ksu_handle_execveat_sucompat_internal(const char __user **filename_user, in
                                                       (const char __user *const __user *)PT_REGS_USER_PTR(regs, 3),
                                                       PT_REGS_SYSCALL_PARM4(regs), true, orig_nr, regs);
 }
+/* IA32 syscall arguments are separate from the native kernel C-call ABI. */
+#if defined(CONFIG_X86_64) && defined(CONFIG_IA32_EMULATION)
+#include "hook/x86_64/ia32_abi.h"
+
+static unsigned long *ksu_ia32_arg_slot(struct pt_regs *regs, unsigned int index)
+{
+    switch (index) {
+    case 0: return &regs->bx;
+    case 1: return &regs->cx;
+    case 2: return &regs->dx;
+    case 3: return &regs->si;
+    case 4: return &regs->di;
+    case 5: return &regs->bp;
+    default: return NULL;
+    }
+}
+
+static void __user *ksu_ia32_stack_string(struct pt_regs *regs, const char *s, size_t len)
+{
+    u32 sp = (u32)regs->sp;
+    void __user *p;
+
+    if (regs->sp != sp || !len || sp < len)
+        return NULL;
+    p = compat_ptr(sp - len);
+    return copy_to_user(p, s, len) ? NULL : p;
+}
+
+static bool ksu_ia32_is_su(const struct pt_regs *regs, unsigned int index)
+{
+    char path[sizeof(su_path)];
+    const char __user *filename = compat_ptr(ksu_ia32_syscall_arg(regs, index));
+    long len = strncpy_from_user(path, filename, sizeof(path));
+
+    return len == sizeof(su_path) - 1 && !memcmp(path, su_path, sizeof(su_path));
+}
+
+static long ksu_ia32_su_query(int orig_nr, struct pt_regs *regs, unsigned int path_index)
+{
+    unsigned long *slot = ksu_ia32_arg_slot(regs, path_index);
+    unsigned long saved;
+    void __user *redirect;
+    const struct cred *old_cred;
+    long ret;
+
+    if (!ksu_ia32_is_su(regs, path_index))
+        return ksu_call_syscall(orig_nr, regs);
+    redirect = ksu_ia32_stack_string(regs, ksud_path, sizeof(ksud_path));
+    if (!redirect)
+        return -EFAULT;
+    old_cred = override_creds(ksu_cred);
+    if (!is_ksud_exists()) {
+        revert_creds(old_cred);
+        return ksu_call_syscall(orig_nr, regs);
+    }
+    saved = *slot;
+    *slot = (u32)(unsigned long)redirect;
+    ret = ksu_call_syscall(orig_nr, regs);
+    *slot = saved;
+    revert_creds(old_cred);
+    return ret;
+}
+
+static long ksu_ia32_su_exec(int orig_nr, struct pt_regs *regs, bool execveat)
+{
+    const unsigned int path_index = execveat ? 1 : 0;
+    const char __user *filename;
+    const char __user *const __user *argv;
+    u32 argv_addr, envp_addr;
+    unsigned long saved[5];
+    void __user *empty;
+    struct file *file;
+    const struct cred *old_cred;
+    const struct cred *before_root;
+    bool already_root;
+    struct ksu_sulog_pending_event *pending;
+    long ret;
+    int tmp_fd, i;
+
+    /* Keep the same supported execveat form as the native sucompat path. */
+    if (execveat && ((int)(u32)regs->bx != AT_FDCWD || (u32)regs->di))
+        return ksu_call_syscall(orig_nr, regs);
+    if (!ksu_ia32_is_su(regs, path_index))
+        return ksu_call_syscall(orig_nr, regs);
+    if (test_thread_flag(TIF_KSU_DISABLE_ESCAPE_WITH_ROOT))
+        return -EPERM;
+
+    empty = ksu_ia32_stack_string(regs, "", 1);
+    if (!empty)
+        return -EFAULT;
+    filename = compat_ptr(ksu_ia32_syscall_arg(regs, path_index));
+    argv_addr = ksu_ia32_syscall_arg(regs, path_index + 1);
+    envp_addr = ksu_ia32_syscall_arg(regs, path_index + 2);
+    argv = compat_ptr(argv_addr);
+    tmp_fd = get_unused_fd_flags(O_CLOEXEC);
+    if (tmp_fd < 0)
+        return tmp_fd;
+    old_cred = override_creds(ksu_cred);
+    file = filp_open(KSUD_PATH, O_PATH, 0);
+    revert_creds(old_cred);
+    if (IS_ERR(file)) {
+        put_unused_fd(tmp_fd);
+        return PTR_ERR(file);
+    }
+    fd_install(tmp_fd, file);
+    pending = ksu_sulog_capture_sucompat_tracepoint(filename, argv, GFP_KERNEL);
+    for (i = 0; i < ARRAY_SIZE(saved); ++i)
+        saved[i] = *ksu_ia32_arg_slot(regs, i);
+
+    /* IA32 execveat(fd, empty, compat argv, compat envp, AT_EMPTY_PATH). */
+    regs->bx = (u32)tmp_fd;
+    regs->cx = (u32)(unsigned long)empty;
+    regs->dx = argv_addr;
+    regs->si = envp_addr;
+    regs->di = AT_EMPTY_PATH;
+    before_root = get_current_cred();
+    already_root = ksu_get_uid_t(current_euid()) == 0;
+    ret = escape_with_root_profile();
+    /* Some upstream abort paths return zero without committing new creds. */
+    if (!ret && !already_root && current_cred() == before_root)
+        ret = -EPERM;
+    put_cred(before_root);
+    ksu_sulog_emit_pending(pending, ret, GFP_KERNEL);
+    if (ret)
+        goto failed;
+
+    /* Direct original-table call: no syscall entry/tracepoint recursion. */
+    ret = ksu_call_syscall(__NR_ia32_execveat, regs);
+    if (ret < 0)
+        goto failed;
+    /* The ELF64 ksud loader may have replaced registers and compat state. */
+    if (ksu_install_su_fd() < 0)
+        pr_warn("IA32 su session FD installation failed\n");
+    return ret;
+
+failed:
+    ksu_close_fd(tmp_fd);
+    for (i = 0; i < ARRAY_SIZE(saved); ++i)
+        *ksu_ia32_arg_slot(regs, i) = saved[i];
+    return ret;
+}
+
+long __nocfi ksu_hook_ia32_sucompat(int orig_nr, const struct pt_regs *user_regs)
+{
+    struct pt_regs *regs = (struct pt_regs *)user_regs;
+
+    if (!in_ia32_syscall() || !static_branch_unlikely(&ksu_su_compat_enabled) ||
+        !ksu_is_allow_uid_for_current(ksu_get_uid_t(current_uid())))
+        return ksu_call_syscall(orig_nr, regs);
+    switch (orig_nr) {
+    case __NR_ia32_execve: return ksu_ia32_su_exec(orig_nr, regs, false);
+    case __NR_ia32_execveat: return ksu_ia32_su_exec(orig_nr, regs, true);
+    case __NR_ia32_access:
+    case __NR_ia32_stat:
+    case __NR_ia32_lstat:
+    case __NR_ia32_stat64:
+    case __NR_ia32_lstat64:
+        return ksu_ia32_su_query(orig_nr, regs, 0);
+    case __NR_ia32_fstatat64:
+    case __NR_ia32_faccessat:
+    case __NR_ia32_faccessat2:
+    case __NR_ia32_statx:
+        return ksu_ia32_su_query(orig_nr, regs, 1);
+    default: return ksu_call_syscall(orig_nr, regs);
+    }
+}
+#endif
+
 #endif
 
 #if defined(CONFIG_KSU_SUSFS) || defined(CONFIG_KSU_MANUAL_HOOK)
