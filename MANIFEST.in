include README.md AGENTS.md CONTRIBUTING.md SECURITY.md THIRD_PARTY.md LICENSE
recursive-include licenses *.txt
recursive-include docs *.md
recursive-include repo-docs *.md
graft docs-site
prune docs-site/node_modules
prune docs-site/.vitepress/cache
prune docs-site/.vitepress/dist
recursive-include native *.c *.h *.S *.py *.sh *.js *.patch *.json *.md
recursive-include targets *.json
recursive-include scripts *.py
recursive-include tests *.py
prune build
prune inputs
prune output
prune bindings
prune .local
prune .venv
global-exclude __pycache__ *.py[cod] *.ko *.o *.so *.apk *.img *.vdi *.vhdx *.log
